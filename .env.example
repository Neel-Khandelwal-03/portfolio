# ---------------------------------------------------------------------------
# Database (required)
# Any PostgreSQL connection string: local, Supabase, Neon, Railway...
# For Supabase/Neon on Vercel use the pooled ("transaction") connection string.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/portfolio"

# ---------------------------------------------------------------------------
# Auth (required)
# 32+ random bytes. Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Admin bootstrap (required only for `npm run admin:create`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="a-strong-password"

# ---------------------------------------------------------------------------
# Public site URL — used for canonical URLs, sitemap and Open Graph images.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# File storage (optional)
# When BLOB_READ_WRITE_TOKEN is set, uploads go to Vercel Blob.
# When it is absent, uploads are written to ./.data/uploads and served from
# /api/media/* — fine for local development, not for serverless production.
# ---------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
